<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Website check-up – {{ audit.domain }}</title>
<style>
:root{--bg:#fff;--fg:#1d2330;--muted:#5d6678;--line:#e3e6ec;--card:#f7f8fa;--fail:#c62828;--warn:#b26a00;--pass:#2e7d32;--nc:#6b7280;--accent:#2f5bd3;
--fail-bg:#fdecec;--warn-bg:#fff4e0;--pass-bg:#e9f5ea;--nc-bg:#eef0f3}
@media (prefers-color-scheme:dark){:root{--bg:#12151b;--fg:#e6e9ef;--muted:#9aa3b2;--line:#2a2f3a;--card:#1a1e26;--fail:#ef5350;--warn:#ffb74d;--pass:#66bb6a;--nc:#9aa3b2;--accent:#7aa2ff;
--fail-bg:#3a1f22;--warn-bg:#3a2e17;--pass-bg:#1d3320;--nc-bg:#23272f}}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--fg);font:15px/1.6 system-ui,-apple-system,Segoe UI,Roboto,sans-serif}
.wrap{max-width:980px;margin:0 auto;padding:24px 16px 64px}
h1{font-size:26px;margin:0 0 4px}h2{font-size:21px;margin:40px 0 6px}h3{font-size:17px;margin:0}
.lead{color:var(--muted);margin:0 0 16px}.muted{color:var(--muted)}.small{font-size:13px}
.card{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:16px}
.hero{display:flex;gap:24px;align-items:center;flex-wrap:wrap}
.big{font-size:56px;font-weight:700;line-height:1}.big small{font-size:20px;color:var(--muted);font-weight:500}
.grade{font-size:20px;font-weight:650;margin-bottom:4px}
.legend{display:flex;flex-wrap:wrap;gap:8px 18px;margin-top:12px;font-size:13px;color:var(--muted)}
.agents{display:grid;gap:10px;grid-template-columns:repeat(auto-fill,minmax(270px,1fr))}
.agent{display:block;text-decoration:none;color:inherit;border-left:4px solid var(--nc)}
.agent .icon{font-size:22px;margin-right:6px}.agent p{margin:6px 0;font-size:13px;color:var(--muted)}
.pill{display:inline-block;font-size:12px;font-weight:600;padding:2px 9px;border-radius:999px;background:var(--nc-bg);color:var(--nc)}
.t-FAIL{border-left-color:var(--fail)}.t-WARNING{border-left-color:var(--warn)}.t-PASS{border-left-color:var(--pass)}
.p-FAIL{background:var(--fail-bg);color:var(--fail)}.p-WARNING{background:var(--warn-bg);color:var(--warn)}.p-PASS{background:var(--pass-bg);color:var(--pass)}
ol.fixes{list-style:none;padding:0;margin:0;counter-reset:n}
ol.fixes>li{counter-increment:n;position:relative;padding-left:44px;margin-bottom:12px}
ol.fixes>li::before{content:counter(n);position:absolute;left:0;top:14px;width:32px;height:32px;border-radius:50%;background:var(--accent);color:#fff;font-weight:700;display:flex;align-items:center;justify-content:center}
.issue{margin-bottom:10px}.issue h3{margin-bottom:4px}
.kv{margin:6px 0 0}.kv b{display:inline-block;min-width:118px}
.who{font-size:13px;color:var(--muted);margin-top:6px}
.section{margin-top:28px;padding-top:8px;border-top:1px solid var(--line)}
.section-head{display:flex;gap:10px;align-items:baseline;flex-wrap:wrap;margin:10px 0}
.section-head .icon{font-size:26px}
ul.simple{list-style:none;padding:0;margin:8px 0}ul.simple li{padding:4px 0;border-bottom:1px dashed var(--line)}
details.tech{margin-top:10px;border:1px solid var(--line);border-radius:8px;background:var(--bg)}
details.tech>summary{cursor:pointer;padding:8px 12px;font-size:13px;color:var(--accent)}
details.tech .body{padding:0 12px 12px;font-size:13px}
table{width:100%;border-collapse:collapse;font-size:12.5px}th,td{text-align:left;padding:5px 7px;border-bottom:1px solid var(--line);vertical-align:top}
th{font-weight:600;color:var(--muted)}td.url{word-break:break-all;max-width:300px}
pre{background:var(--card);border:1px solid var(--line);border-radius:6px;padding:8px;overflow:auto;font-size:12px;white-space:pre-wrap;word-break:break-word;margin:6px 0}
.scroll{overflow-x:auto}
dl.glossary dt{font-weight:650;margin-top:8px}dl.glossary dd{margin:0 0 0 0;color:var(--muted)}
@media print{details.tech{display:none}.agent{break-inside:avoid}.issue{break-inside:avoid}}
</style>
</head>
<body><div class="wrap">

<h1>Website check-up: {{ audit.domain }}</h1>
<p class="lead">{{ audit.url }} · {{ (audit.finished_at or generated_at)[:10] }}{% if plain.pages_checked %} · our agents visited {{ plain.pages_checked }} pages{% endif %}</p>

<div class="card">
  <div class="hero">
    <div class="big">{{ scores.overall if scores.overall is not none else "–" }}<small> / 100</small></div>
    <div>
      <div class="grade">{{ plain.grade.label }}</div>
      <div>{{ plain.grade.sentence }}</div>
      <div class="muted small">{{ plain.counts_sentence }}{% if coverage is not none and coverage < 100 %} We could test {{ coverage }}% of what we look at; the rest needs extra access (explained below).{% endif %}</div>
    </div>
  </div>
  <div class="legend"><span>🔴 Needs fixing</span><span>🟠 Could be better</span><span>🟢 Looks good</span><span>⚪ Couldn't check or doesn't apply</span></div>
  <p class="muted small" style="margin:8px 0 0">The score is like a health check: it shows how many of our checks your site passed, weighted by how much each one matters. It is not your position in Google.</p>
</div>

<h2>Meet your agents</h2>
<p class="lead">Each agent checks one part of your website. Click an agent to see what it found.</p>
<div class="agents">
{% for a in agents %}
  <a class="card agent t-{{ a.tone }}" href="#agent-{{ a.key }}">
    <h3><span class="icon">{{ a.icon }}</span>{{ a.name }}</h3>
    <p>{{ a.job }}</p>
    <span class="pill p-{{ a.tone }}">{{ a.verdict }}</span>
  </a>
{% endfor %}
</div>

<h2>Fix these first</h2>
<p class="lead">The changes that will help the most for the least effort, in order.</p>
{% if top_fixes %}
<ol class="fixes">
{% for f in top_fixes %}
  <li><div class="card">
    <h3>{{ f.plain_icon }} {{ f.plain_title }}</h3>
    <div class="muted small">{{ f.agent_icon }} {{ f.agent }} · {{ f.plain_status }}</div>
    <p class="kv"><b>What we found</b> {{ f.plain_found }}</p>
    <p class="kv"><b>Why it matters</b> {{ f.plain_why }}</p>
    <p class="kv"><b>What to do</b> {{ f.plain_do }}</p>
    <div class="who">👤 Who can do it: {{ f.plain_who }}</div>
  </div></li>
{% endfor %}
</ol>
{% else %}<p class="muted">Nothing urgent. Well done!</p>{% endif %}

<h2>What each agent found</h2>
{% for a in agents %}
<div class="section" id="agent-{{ a.key }}">
  <div class="section-head"><span class="icon">{{ a.icon }}</span><h3>{{ a.name }}</h3><span class="pill p-{{ a.tone }}">{{ a.verdict }}</span></div>
  <p class="muted" style="margin-top:0">{{ a.job }}</p>
  {% if a.planned %}
  <p class="muted">This agent is still being built and will join in a later update.</p>
  {% else %}
  {% for f in a.findings if f.status in ['FAIL', 'WARNING'] %}
  <div class="card issue">
    <h3>{{ f.plain_icon }} {{ f.plain_title }}</h3>
    <p class="kv"><b>What we found</b> {{ f.plain_found }}</p>
    <p class="kv"><b>Why it matters</b> {{ f.plain_why }}</p>
    <p class="kv"><b>What to do</b> {{ f.plain_do }}</p>
    <div class="who">👤 Who can do it: {{ f.plain_who }}</div>
    {% include "_tech.html.j2" %}
  </div>
  {% endfor %}
  {% set rest = a.findings | rejectattr('status', 'in', ['FAIL', 'WARNING']) | list %}
  {% if rest %}
  <ul class="simple">
  {% for f in rest %}
    <li>{{ f.plain_icon }} <b>{{ f.plain_title }}</b> <span class="muted">· {{ f.plain_status }}{% if f.status != 'PASS' %}: {{ f.plain_found }}{% endif %}</span>
      {% if f.status == 'PASS' and (f['items'] or f.generated_fix) %}{% include "_tech.html.j2" %}{% endif %}</li>
  {% endfor %}
  </ul>
  {% endif %}
  {% endif %}
</div>
{% endfor %}

<h2>Words you might see</h2>
<dl class="glossary">
  <dt>Google headline (title)</dt><dd>The blue clickable text for your page in Google results.</dd>
  <dt>Google summary (meta description)</dt><dd>The short grey text under the headline in Google results.</dd>
  <dt>Main heading (H1)</dt><dd>The biggest heading on the page itself, saying what the page is about.</dd>
  <dt>Page list (sitemap)</dt><dd>A file listing all your pages so Google can find them quickly.</dd>
  <dt>Image description (alt text)</dt><dd>Hidden text describing a picture, read by Google and by screen readers for blind visitors.</dd>
  <dt>Google labels (structured data)</dt><dd>Hidden information that tells Google what a page is: your company, a product, an article.</dd>
  <dt>Link votes (backlinks)</dt><dd>Links to your site from other websites. Google treats them as votes of trust.</dd>
  <dt>Search phrase (keyword)</dt><dd>The words people type into Google, e.g. "go kart manufacturer india".</dd>
</dl>

<h2>For your web developer</h2>
<p class="lead">Technical details of how the check-up was done. Each finding above also has a "Technical details" link with the exact pages and ready-made fixes. A CSV/JSON export is available from the dashboard.</p>
<details class="tech"><summary>Crawl details</summary><div class="body">
<table><tbody>
<tr><th>Start URL</th><td>{{ site.start_url }}</td></tr>
<tr><th>Pages fetched</th><td>{{ site.crawl.pages_fetched }} (limit {{ site.crawl.limit }}{% if site.crawl.limit_reached %}, limit reached{% endif %}) · rendered with JS: {{ site.crawl.rendered_pages }} · {{ site.crawl.duration_s }} s</td></tr>
<tr><th>robots.txt</th><td>HTTP {{ site.robots.status }}{% if site.robots.sitemaps %} · Sitemap lines: {{ site.robots.sitemaps|join(', ') }}{% endif %}</td></tr>
<tr><th>Sitemaps</th><td>{% for s in site.sitemaps %}{{ s.url }} ({{ s.status }}{% if s.url_count %}, {{ s.url_count }} URLs{% endif %}{% if s.error %}, {{ s.error }}{% endif %})<br>{% else %}none found{% endfor %}</td></tr>
<tr><th>llms.txt</th><td>{{ 'present' if site.llms_txt.present else 'not found' }} (HTTP {{ site.llms_txt.status }})</td></tr>
<tr><th>AI crawlers</th><td>{% for bot, r in (site.ai_bots or {}).items() %}{{ bot }}: {{ 'allowed' if r.root_allowed else 'blocked' }}{% if r.has_specific_group %} (specific rule){% endif %}<br>{% endfor %}</td></tr>
<tr><th>JavaScript site</th><td>{{ 'yes – content depends on JS' if site.js_site else 'no' }}</td></tr>
<tr><th>Scores by category</th><td>{% for key, c in (scores.categories or {}).items() %}{{ category_labels.get(key, key) }}: {{ c.score if c.score is not none else '–' }} (coverage {{ c.coverage }}%)<br>{% endfor %}</td></tr>
<tr><th>Generated by</th><td>{{ generator }} · audit #{{ audit.id }} · {{ generated_at }}</td></tr>
</tbody></table></div></details>
<details class="tech"><summary>All pages ({{ pages|length }})</summary><div class="body scroll">
<table><thead><tr><th>URL</th><th>Status</th><th>Depth</th><th>Inlinks</th><th>Words</th><th>Indexable</th><th>Title</th></tr></thead><tbody>
{% for p in pages[:500] %}<tr><td class="url">{{ p.url }}</td><td>{{ p.status_code }}</td><td>{{ p.depth if p.depth is not none else '—' }}</td><td>{{ p.inlinks }}</td><td>{{ p.word_count or '' }}</td><td>{{ 'yes' if p.indexable else 'no' }}</td><td>{{ p.title or '' }}</td></tr>{% endfor %}
</tbody></table></div></details>

</div></body></html>
