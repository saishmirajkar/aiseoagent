# SEO Inspector on Replit. See README.md › "Deploying on Replit".
modules = ["python-3.11", "nodejs-20", "postgresql-16"]
run = "python -m app.run"

[nix]
channel = "stable-24_05"

[env]
PYTHONPATH = "backend"

[deployment]
deploymentTarget = "vm"
build = ["sh", "-c", "pip install -r requirements.txt && npm --prefix frontend ci && npm --prefix frontend run build"]
run = ["sh", "-c", "python -m app.run"]

[[ports]]
localPort = 8000
externalPort = 80
